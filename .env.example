# cc-os 환경변수 (.env.local 로 복사 후 값 채우기) — 값은 Vercel 프로젝트 환경변수에서 복사
# ⚠️ .env.local 은 git에 커밋 금지. 비밀키는 비밀번호 매니저 등 안전 경로로 공유.

# ── 필수 (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_APP_URL=https://cc-os.81degree.com

# ── AI (Claude) ── 메일 파싱·답장 초안·오리엔/의뢰 요약
ANTHROPIC_API_KEY=
ORIENT_AI_MODEL=claude-haiku-4-5-20251001

# ── Slack ──
SLACK_BOT_TOKEN=            # xoxb- (알림/스레드 게시·읽기)
SLACK_SIGNING_SECRET=       # Slack 앱 Basic Information (이벤트 검증)
SLACK_WEBHOOK_URL=          # (선택) 웹훅
# 채널 ID 오버라이드(미설정 시 코드 기본값)
PR_SLACK_CHANNEL=           # #cc_pr_gmail (팀)
CREATOR_SLACK_CHANNEL=      # #05_cc (크리에이터)
ACCOUNTING_SLACK_CHANNEL=   # 경리
SCHEDULE_SLACK_CHANNEL=     # 제작일정
SLACK_REPLY_EMOJI=ok_hand   # 회신 초안 트리거 이모지

# ── 메일 인입 / 경리 시트 연동 ──
DEALS_INGEST_SECRET=        # contact@ Apps Script → /api/deals/ingest-email
PR_LIST_SECRET=             # /api/public/pr-list (구글시트 Apps Script)

# ── 인스타그램(Meta) 연동 ── (코드가 IG_* / META_* 둘 다 참조)
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# ── 크론 / 이메일 발송(선택) ──
CRON_SECRET=               # Vercel 크론 보호
RESEND_API_KEY=            # 이메일 발송(Resend)
RESEND_FROM=81degree <onboarding@resend.dev>
